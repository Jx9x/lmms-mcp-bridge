# New top-level files and folders stay private until explicitly allowed here.
/*
!/.gitattributes
!/.gitignore
!/AGENTS.md
!/README.md
!/LICENSE
!/LICENSES/
!/THIRD_PARTY_NOTICES.md
!/requirements.txt
!/start-lmms-with-bridge.bat
!/.agents/
!/.github/
!/Images/
!/docs/
!/plugin/
!/scripts/
!/sdk/
!/tests/

# Publish only the LMMS operation skill from local agent configuration.
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/lmms-operation-instructions/

# Generated SDK inputs and private verification notes are rebuilt or kept locally.
/sdk/lib/
/sdk/analysis/
/docs/verification-evidence.md

# Local configuration, environments, caches, and generated outputs at any depth.
.idea/
.vscode/
.devin/
.venv*/
venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.iml
*.py[cod]
*.a
*.o
*.obj
*.dll
*.exe
*.pdb
*.log
*.tmp
*.bak
*.local.json
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.p12
*.pfx
